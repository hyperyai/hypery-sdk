// The tools a parent agent uses to run its agents (Claude Code's Agent / SendMessage / TaskStop / ListAgents, dune's
// task / await_job), bound to an agent runtime. A host adds them to its own tool list; `execOrchestrationTool` runs
// one. Parent-only: a child never gets them.

import { LoopTool } from "./loop.tish"
import { AgentRuntime } from "./runtime.tish"
import { StopSignal, ToolCall, ToolRun } from "./types.tish"

export const ORCHESTRATION_TOOLS = ["task", "send_message", "stop_agent", "list_agents", "await_agent"]

export type ProfileLine = { id: string, description: string }
export type OrchestrationOptions = { signal: StopSignal?, readOnly: boolean? }

fn toolSpec(name: string, description: string, properties: any, required: string[]): any {
  return { type: "function", "function": { name: name, description: description, parameters: { type: "object", properties: properties, required: required } } }
}

// Specs for the parent's orchestration tools. `profiles` lists the agent types the model can choose from.
export fn orchestrationTools(runtime: AgentRuntime, profiles: ProfileLine[]): LoopTool[] {
  let types = profiles.map(fn(p) { return "- " + p.id + ": " + p.description }).join("\n")
  return [
    {
      // Independent of the other calls in a round: several start together.
      readOnly: true,
      acts: false,
      spec: toolSpec("task", [
        "Start an agent to do a self-contained piece of work with its own fresh context; only its answer comes back. Use agents to keep your own context small and to work in parallel: several task calls in one message run at once.",
        "The agent cannot see this conversation: put everything it needs in the prompt (scope, goal, constraints, what to report).",
        "Background agents return an id at once and report back as a notification; foreground ones return their answer. Every agent has an id you can send_message to (to steer it while it runs, or to continue it later with its context), stop_agent, or check with await_agent.",
        "Agent types:\n" + types
      ].join("\n\n"), {
        subagent_type: { type: "string", description: "One of the agent types above." },
        prompt: { type: "string", description: "The self-contained task." },
        description: { type: "string", description: "A short label, e.g. \"Review the pricing page\"." },
        run_in_background: { type: "boolean", description: "Return its id now and keep working; its answer arrives as a notification. Leave it out for the agent type's default." },
        readonly: { type: "boolean", description: "Read-only tools only, whatever the type allows." }
      }, ["subagent_type", "prompt"])
    },
    {
      readOnly: true, acts: false,
      spec: toolSpec("send_message", "Message an agent by id. A running agent reads it at its next step (steer it, answer its question). A finished one is resumed with its whole context and this message; set wait to get its answer now, otherwise it arrives as a notification.", {
        agent_id: { type: "string" },
        message: { type: "string" },
        wait: { type: "boolean", description: "Resume a finished agent and wait for its answer." }
      }, ["agent_id", "message"])
    },
    { readOnly: true, acts: false, spec: toolSpec("stop_agent", "Stop one running agent by id.", { agent_id: { type: "string" } }, ["agent_id"]) },
    { readOnly: true, acts: false, spec: toolSpec("list_agents", "List your agents with their status and last answer.", {}, []) },
    {
      readOnly: true, acts: false,
      spec: toolSpec("await_agent", "Wait for an agent by id to finish and get its answer (or its status when the wait times out). Use it when you need the answer before you can go on; otherwise keep working and let it notify you.", {
        agent_id: { type: "string" },
        timeout_seconds: { type: "number", description: "How long to wait at most (default 120, at most 600)." }
      }, ["agent_id"])
    }
  ]
}

export fn isOrchestrationTool(name: string): boolean {
  return ORCHESTRATION_TOOLS.includes(name)
}

fn result(call: ToolCall, summary: string, data: any, ok: boolean): ToolRun {
  return { id: call.id, name: call.name, argsText: call.argsText, ok: ok, summary: summary, content: JSON.stringify(data) }
}

fn withActed(run: ToolRun, acted: boolean): ToolRun {
  return { ...run, acted: acted }
}

// Run one orchestration tool call against `runtime`. `signal` is the parent turn's (its Stop stops foreground agents).
export async fn execOrchestrationTool(runtime: AgentRuntime, call: ToolCall, opts: OrchestrationOptions?): ToolRun {
  let o = opts ?? {}
  let signal = o.signal ?? null
  let args = {}
  try {
    args = JSON.parse(call.argsText === "" ? "{}" : call.argsText)
  } catch (e) {
    return result(call, "invalid arguments", { error: "Arguments are not valid JSON." }, false)
  }
  let str = fn(k: string): string { return typeof args[k] === "string" ? args[k] : "" }
  // Handing work to an agent that can make changes is acting: the parent shouldn't be nudged to redo it.
  let canAct = fn(id: string): boolean {
    let s = runtime.get(id)
    return s !== null && s.readOnly === false
  }
  if (call.name === "task") {
    let r = await runtime.spawn({
      profileId: str("subagent_type"), prompt: str("prompt"), description: str("description") !== "" ? str("description") : null,
      background: typeof args.run_in_background === "boolean" ? args.run_in_background : null, readOnly: o.readOnly === true || args.readonly === true, signal: signal, parentCallId: call.id
    })
    if (r.kind === "refused") { return result(call, "refused", { error: r.reason }, false) }
    if (r.kind === "started") {
      return withActed(result(call, str("subagent_type") + " started (" + r.id + ")", { agent_id: r.id, status: "running", note: "Keep working: its answer arrives as a notification." }, true), canAct(r.id))
    }
    return withActed(result(call, str("subagent_type") + ": " + (r.ok ? "done" : "failed"), { agent_id: r.id, ok: r.ok, rounds: r.rounds, answer: r.summary }, r.ok === true), canAct(r.id))
  }
  if (call.name === "send_message") {
    let r = await runtime.message(str("agent_id"), str("message"), { wait: args.wait === true, signal: signal })
    if (r.kind === "unknown") { return result(call, "unknown agent", { error: "No agent \"" + str("agent_id") + "\"." }, false) }
    let acted = canAct(r.id)
    if (r.kind === "queued") { return withActed(result(call, "delivered", { agent_id: r.id, status: "running", note: "It reads this at its next step." }, true), acted) }
    if (r.kind === "resumed") { return withActed(result(call, "resumed", { agent_id: r.id, status: "running", note: "Its answer arrives as a notification." }, true), acted) }
    return withActed(result(call, r.ok ? "answered" : "failed", { agent_id: r.id, ok: r.ok, answer: r.summary }, true), acted)
  }
  if (call.name === "stop_agent") {
    let stopped = runtime.stop(str("agent_id"))
    return result(call, stopped ? "stopped" : "not running", { agent_id: str("agent_id"), stopped: stopped }, true)
  }
  if (call.name === "list_agents") {
    let rows = runtime.list().map(fn(s) { return { agent_id: s.id, type: s.profile, description: s.description, status: s.status, answer: s.summary ?? null } })
    return result(call, String(rows.length) + " agent" + (rows.length === 1 ? "" : "s"), { agents: rows }, true)
  }
  if (call.name === "await_agent") {
    let seconds = typeof args.timeout_seconds === "number" ? Math.min(Math.max(args.timeout_seconds, 1), 600) : 120
    let s = await runtime.wait(str("agent_id"), { timeoutMs: seconds * 1000, signal: signal })
    if (s === null) { return result(call, "unknown agent", { error: "No agent \"" + str("agent_id") + "\"." }, false) }
    let busy = s.status === "running" || s.status === "queued"
    if (!busy) { runtime.dismissFinished(s.id) }
    let data = { agent_id: s.id, status: s.status, answer: s.summary ?? null }
    if (busy) { data.note = "Still " + s.status + " after " + String(seconds) + "s. Carry on; it notifies you when it finishes." }
    return result(call, s.id + ": " + s.status, data, true)
  }
  return result(call, "unknown tool", { error: call.name + " is not an orchestration tool." }, false)
}
