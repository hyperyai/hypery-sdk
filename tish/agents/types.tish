// The agent core's vocabulary: OpenAI-style chat messages and tool specs (what Hypery's gateway speaks), and the
// tools and profiles a host plugs in. Nothing here knows about a product — PopCraft, Dune and Hypery each supply
// their own tools, prompts, model call and storage.
//
// Written in Tish: one source runs natively (Dune's cloud agents) and compiles to the npm package's JavaScript, with
// these types emitted as its TypeScript declarations.

export type ChatContentPart = {
  type: string,
  text: string?,
  image_url: { url: string }?
}

export type ChatToolCallRef = {
  id: string,
  type: "function",
  "function": { name: string, arguments: string }
}

export type ChatMessage = {
  role: "system" | "user" | "assistant" | "tool",
  content: string | ChatContentPart[],
  tool_calls: ChatToolCallRef[]?,
  tool_call_id: string?,
  name: string?
}

export type ChatToolSpec = {
  type: "function",
  "function": { name: string, description: string, parameters: any }
}

// One assistant turn as the host's model call returns it.
export type ModelTurn = {
  text: string,
  reasoning: string?,
  toolCalls: { id: string, name: string, arguments: string }[]
}

export type ToolProgress = { index: number, name: string, bytes: number, arguments: string }

export type ModelHooks = {
  onTextDelta: ((string) => void)?,
  onReasoningDelta: ((string) => void)?,
  // A tool call's arguments are still streaming in (what has arrived so far).
  onToolProgress: ((ToolProgress) => void)?
}

// Anything with an `aborted` flag stops work that checks it: a JS AbortSignal, or a plain `{ aborted: false }`
// a native host flips.
export type StopSignal = { aborted: boolean }

// Which tool the model must call: "auto" (its choice, the default), "required" (any tool), "none", or one tool by
// name (`forceTool(name)`), as OpenAI's `tool_choice`.
export type ToolChoice = "auto" | "required" | "none" | { type: "function", "function": { name: string } }

// Per-call request options a host's model call honours.
export type ModelRequest = { toolChoice: ToolChoice? }

// The host's model call: one streamed assistant turn. `request` is absent for a plain call.
export type CallModel = (ChatMessage[], ChatToolSpec[], ModelHooks, StopSignal?, ModelRequest?) => Promise<ModelTurn>

// A `ToolChoice` that makes the model call the tool `name`.
export fn forceTool(name: string): ToolChoice {
  return { type: "function", "function": { name: name } }
}

export type ToolCall = { id: string, name: string, argsText: string }

export type ToolRun = {
  id: string,
  name: string,
  argsText: string,
  ok: boolean,
  summary: string,
  // Serialized result handed back to the model.
  content: string,
  // Images to show the model after the round (e.g. a render), as data or https URLs.
  images: string[]?,
  // Whether this call changed something, when that depends on the call (delegating to an agent that can make
  // changes). Overrides the tool's `acts`.
  acted: boolean?
}

// An agent type (Claude Code's subagent types, Dune's profiles): its instructions, the tools it may call, the model
// it runs on, and how long it may go.
export type AgentProfile = {
  id: string,
  // One line for the model choosing whom to delegate to.
  description: string,
  // The child's system prompt (the host may add its own context after it).
  instructions: string,
  // Tool names this type may call; ["*"] for every tool the host offers children.
  tools: string[],
  // Never edits: only read-only tools, whatever `tools` says.
  readOnly: boolean?,
  // A model id, "inherit" (the parent's), or "fast" (the host's cheapest tool-capable model).
  model: string?,
  // Round budget; 0 or absent means the core default.
  maxRounds: number?,
  // Runs in the background unless the call says otherwise.
  background: boolean?
}
