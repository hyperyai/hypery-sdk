// Orchestration modes: how much model choreography a run gets. The SDK holds no models or limits of its own: they
// come from an orchestration skill (orchestration-skill.tish) the product ships and the user edits, chosen per task.
//
// - "off":   exactly the host's model call; children inherit it. Nothing added.
// - "auto" / "ultra": the skill chosen for the task (one that lists the mode) sets the roles — lead, swarm, advisor,
//            router — and their efforts, triggers and limits. No skill: the run behaves as "off".
//
// `createOrchestration` turns a mode, a skill and the host's model call into the pieces the runtime and loop take.

import { CallModel, Effort } from "./types.tish"
import { RolePolicy, RoleSpec, mergeRoles, resolveRole, roleModel, roleOfProfileModel } from "./roles.tish"
import { Advise, AdvisorEvent, AdvisorTriggers, createAdvisor } from "./advisor.tish"
import { Route, RouterEvent, createRouter } from "./router.tish"
import { OrchestrationSkill } from "./orchestration-skill.tish"

export type OrchestrationMode = "off" | "auto" | "ultra"

export type OrchestrationEvent = {
  type: "skill" | "role:model" | "advisor:call" | "advisor:advice" | "router:pick",
  skill: string?,
  role: string?,
  model: string?,
  trigger: string?,
  calls: number?,
  tokensRead: number?,
  advice: string[]?,
  verdict: string?,
  round: number?,
  tool: string?,
  p: number?,
  sharp: boolean?
}

export type OrchestrationOptions = {
  mode: OrchestrationMode?,
  // The orchestration skill for this task (see chooseOrchestrationSkill). None: the run behaves as "off".
  skill: OrchestrationSkill?,
  // Per-role overrides laid over the skill's: a model id, or `{ model, effort, fallback }`.
  roles: any?,
  // The live model catalog (ids or `{ id }`): role models fall back along their chains to ones it has.
  catalog: any[]?,
  // The user's effort ("Faster ↔ Smarter"): the lead's effort, over the skill's.
  effort: Effort?,
  // Background children at once, over the skill's `max_concurrent`.
  maxConcurrent: number?,
  onEvent: ((OrchestrationEvent) => void)?
}

export type Orchestration = {
  mode: OrchestrationMode,
  // The skill in use, or null (the run is plain "off").
  skill: OrchestrationSkill?,
  roles: RolePolicy,
  // Null: the host's own limit.
  maxConcurrent: number?,
  // The skill's guidance for the lead's system prompt ("" for none).
  guidance: string,
  // The lead's model call (the host's own in "off").
  callModel: CallModel,
  // A child's model call from its profile's `model`, or null for the lead's.
  childModel: (string?) => CallModel?,
  // For `runAgentLoop`: present only in ultra.
  advise: Advise?,
  route: Route?
}

export fn normalizeMode(mode: any): OrchestrationMode {
  if (mode === "off" || mode === false) { return "off" }
  if (mode === "ultra") { return "ultra" }
  return "auto"
}

export fn createOrchestration(callModel: CallModel, opts: OrchestrationOptions?): Orchestration {
  let o = opts ?? {}
  let mode = normalizeMode(o.mode ?? "auto")
  let skill = o.skill !== null && typeof o.skill === "object" ? o.skill : null
  let catalog = o.catalog ?? null
  let emit = fn(e: any): void {
    if (typeof o.onEvent === "function") { o.onEvent(e) }
  }
  let hostLimit = typeof o.maxConcurrent === "number" ? o.maxConcurrent : null
  if (mode === "off" || skill === null) {
    return {
      mode: mode, skill: null, roles: {}, maxConcurrent: hostLimit, guidance: "",
      callModel: callModel,
      childModel: fn(m: string?): any { return null },
      advise: null, route: null
    }
  }
  emit({ type: "skill", skill: skill.name })
  let roles = mergeRoles(skill.roles, o.roles ?? null)
  if (typeof o.effort === "string" && (roles.lead ?? null) !== null) { roles = mergeRoles(roles, { lead: { effort: o.effort } }) }
  let specs = {}
  let calls = {}
  // A role's model call, or null when the skill does not use that role.
  let callFor = fn(role: string): any {
    if ((calls[role] ?? null) === null) {
      let spec = resolveRole(role, roles, catalog)
      if (spec === null) { return null }
      specs[role] = spec
      calls[role] = roleModel(callModel, spec)
      emit({ type: "role:model", role: role, model: spec.model })
    }
    return calls[role]
  }
  let lead = callFor("lead") ?? callModel
  let advise = null
  let route = null
  if (callFor("advisor") !== null) {
    let triggers = null
    if (Array.isArray(skill.advisorTriggers)) {
      triggers = { plan: skill.advisorTriggers.includes("plan"), done: skill.advisorTriggers.includes("done"), error: skill.advisorTriggers.includes("error"), ask: skill.advisorTriggers.includes("ask") }
    }
    advise = createAdvisor({
      callModel: callModel, spec: specs.advisor, triggers: triggers,
      maxCalls: skill.advisorMaxCalls ?? null, maxChars: null, guidance: skill.guidance,
      onEvent: fn(e: AdvisorEvent): void { emit(e) }
    }).advise
  }
  if (typeof skill.routerThreshold === "number" && callFor("router") !== null) {
    route = createRouter({
      callModel: callModel, spec: specs.router, threshold: skill.routerThreshold,
      onEvent: fn(e: RouterEvent): void { emit(e) }
    })
  }
  return {
    mode: mode, skill: skill, roles: roles,
    maxConcurrent: hostLimit ?? skill.maxConcurrent ?? null,
    guidance: skill.guidance,
    callModel: lead,
    childModel: fn(profileModel: string?): any {
      let role = roleOfProfileModel(profileModel)
      // A pinned model id: the lead's call with that model.
      if (role === null) { return roleModel(callModel, { model: profileModel, effort: (specs.lead ?? {}).effort ?? null, fallback: null }) }
      // A role the skill does not use runs on the lead.
      return callFor(role) ?? lead
    },
    advise: advise,
    route: route
  }
}
