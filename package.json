{
  "name": "@hyperyai/sdk",
  "version": "1.0.1",
  "type": "module",
  "description": "Drop-in authentication, checkout, and error handling for apps built on Hypery",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hyperyai/hypery-sdk.git"
  },
  "homepage": "https://github.com/hyperyai/hypery-sdk#readme",
  "bugs": {
    "url": "https://github.com/hyperyai/hypery-sdk/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./agents": {
      "tish": "./tish/agents/index.tish",
      "types": "./dist/agents/index.d.ts",
      "source": "./src/agents/index.ts",
      "default": "./dist/agents/index.js"
    },
    "./agents/node": {
      "types": "./dist/agents/node/index.d.ts",
      "source": "./src/agents/node/index.ts",
      "default": "./dist/agents/node/index.js"
    },
    "./agents/react": {
      "types": "./dist/agents/react.d.ts",
      "source": "./src/agents/react.ts",
      "default": "./dist/agents/react.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "source": "./src/testing.tsx",
      "default": "./dist/testing.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src/",
    "tish/",
    "dist/",
    "README.md",
    "!src/**/__tests__"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run build:core && tsc -p tsconfig.json && node scripts/copy-core.mjs && npm run build:css",
    "build:css": "tailwindcss -i src/styles.css -o dist/styles.css --minify",
    "test": "bun test src",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build",
    "typecheck:examples": "tsc -p examples/agents/tsconfig.json && tsc -p examples/scopes/tsconfig.json",
    "build:core": "tish build tish/agents/index.tish --target js --format esm --types -o src/agents/core",
    "pretest": "npm run build:core",
    "test:tish": "node scripts/test-tish.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.0.5",
    "clsx": "^2.1.0",
    "lucide-react": "^1.24.0",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "@tishlang/tish": "4.2.2"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "hypery",
    "auth",
    "authentication",
    "oauth",
    "pkce",
    "react",
    "checkout",
    "error-handling",
    "spending-limits",
    "credits",
    "agents",
    "subagents",
    "agent-loop"
  ]
}
